<Window x:Class="PlexRecentlyAddedEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Plex Recently Added Editor" Height="560" Width="600"
        WindowStartupLocation="CenterOwner" Icon="app.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <RichTextBox Grid.Row="0" IsReadOnly="True" IsDocumentEnabled="True"
                      VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                      IsReadOnlyCaretVisible="True">
            <FlowDocument FontSize="13" PagePadding="0">

                <Paragraph FontSize="18" FontWeight="Bold" Margin="0,0,0,0">Plex Recently Added Editor</Paragraph>
                <Paragraph x:Name="VersionParagraph" Foreground="Gray" Margin="0,0,0,10"/>

                <Paragraph>
                    Lets you review your Plex libraries' "recently added" lists and fix items whose
                    added-date got bumped by something other than a genuine new add (a re-encode, a
                    folder reorg, a re-scan), so they stop cluttering Recently Added.
                </Paragraph>

                <Paragraph FontWeight="Bold" Margin="0,16,0,4">No telemetry. No phone-home.</Paragraph>
                <Paragraph>
                    This app collects, transmits, and stores nothing outside your own computer and the
                    services you explicitly connect it to. No analytics, no telemetry, no crash reporting,
                    no usage tracking - it never contacts the developer or any third party on its own.
                </Paragraph>
                <Paragraph>
                    It only ever talks to: the Plex server URL you enter; plex.tv, but only if you use
                    "Sign in with Plex"; and api.themoviedb.org, but only if you provide a TMDb API key.
                    Your Plex token and TMDb key are kept in memory for the session only and are never
                    written to disk by this app. Full details are in the project's security policy.
                </Paragraph>

                <Paragraph FontWeight="Bold" Margin="0,16,0,4">Open source</Paragraph>
                <Paragraph>
                    The full source is public and MIT-licensed - read it, audit it, or build it yourself
                    instead of trusting a downloaded binary.
                </Paragraph>
                <Paragraph>
                    <Hyperlink NavigateUri="https://github.com" RequestNavigate="Hyperlink_RequestNavigate" x:Name="RepoLink">
                        View source on GitHub
                    </Hyperlink>
                    &#160;&#160;|&#160;&#160;
                    <Hyperlink NavigateUri="https://github.com" RequestNavigate="Hyperlink_RequestNavigate" x:Name="SecurityLink">
                        Read the full security policy
                    </Hyperlink>
                </Paragraph>

            </FlowDocument>
        </RichTextBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Padding="16,4" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
