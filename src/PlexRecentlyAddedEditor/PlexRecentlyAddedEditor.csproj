<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PlexRecentlyAddedEditor</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>PlexRecentlyAddedEditor contributors</Authors>
    <Product>Plex Recently Added Editor</Product>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="app.ico" />
  </ItemGroup>

  <!-- These only kick in for `dotnet publish`, not normal `dotnet build`, so day-to-day
       development stays fast. See README for the exact publish command. -->
  <PropertyGroup Condition="'$(PublishSingleFile)'=='true' Or '$(SelfContained)'=='true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
