<Window x:Class="PlexRecentlyAddedEditor.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Getting your Plex token and TMDb API key" Height="620" Width="640"
        WindowStartupLocation="CenterOwner" Icon="app.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <RichTextBox Grid.Row="0" IsReadOnly="True" IsDocumentEnabled="True"
                      VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                      IsReadOnlyCaretVisible="True">
            <FlowDocument FontSize="13" PagePadding="0">

                <Paragraph FontSize="16" FontWeight="Bold">Getting your Plex token</Paragraph>

                <Paragraph FontWeight="Bold">Option A - fastest, no typing</Paragraph>
                <Paragraph>
                    On the main screen, click <Bold>"Sign in with Plex"</Bold>. It opens your browser to
                    approve this app, then fills the token in for you automatically.
                </Paragraph>

                <Paragraph FontWeight="Bold">Option B - if this app runs on the same PC as your Plex server</Paragraph>
                <Paragraph>
                    Click <Bold>"Detect local token"</Bold>. This reads the token straight out of your
                    server's Preferences.xml file. If your server's data directory has been moved off its
                    default location, this may not find it - in that
                    case use <Bold>"Browse for Preferences.xml..."</Bold> and point it at the file yourself.
                    It's usually named <Italic>Preferences.xml</Italic> inside a folder called
                    <Italic>Plex Media Server</Italic>, wherever your server's application data lives.
                </Paragraph>

                <Paragraph FontWeight="Bold">Option C - fully manual, works from any device</Paragraph>
                <Paragraph>
                    1. Open Plex Web and sign in.<LineBreak/>
                    2. Browse to any movie or show.<LineBreak/>
                    3. Click the "..." (more) button on it, then "Get Info", then "View XML".<LineBreak/>
                    4. A new tab opens - look at its address bar. The token is the value after
                    <Italic>X-Plex-Token=</Italic> near the end of the URL. Copy just that value.
                </Paragraph>
                <Paragraph>
                    <Hyperlink NavigateUri="https://app.plex.tv/desktop" RequestNavigate="Hyperlink_RequestNavigate">
                        Open Plex Web
                    </Hyperlink>
                    &#160;&#160;|&#160;&#160;
                    <Hyperlink NavigateUri="https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/" RequestNavigate="Hyperlink_RequestNavigate">
                        Official Plex support article on finding your token
                    </Hyperlink>
                </Paragraph>

                <Paragraph FontSize="16" FontWeight="Bold" Margin="0,20,0,0">Getting a TMDb API key</Paragraph>
                <Paragraph>
                    This app uses The Movie Database (TMDb) to look up a title's real release date (or an
                    episode's air date). It's free.
                </Paragraph>
                <Paragraph>
                    1. Create a free account at themoviedb.org.<LineBreak/>
                    2. Go to your account Settings, then the "API" section.<LineBreak/>
                    3. Click "Create" / request an API key, and choose the "Developer" option.<LineBreak/>
                    4. Fill in the short form - for personal use, any app name/description is fine.<LineBreak/>
                    5. Copy the "API Key (v3 auth)" value into this app's TMDb API Key field.
                </Paragraph>
                <Paragraph>
                    <Hyperlink NavigateUri="https://www.themoviedb.org/signup" RequestNavigate="Hyperlink_RequestNavigate">
                        Create a TMDb account
                    </Hyperlink>
                    &#160;&#160;|&#160;&#160;
                    <Hyperlink NavigateUri="https://www.themoviedb.org/settings/api" RequestNavigate="Hyperlink_RequestNavigate">
                        Open TMDb API settings
                    </Hyperlink>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy Plex token article link" Padding="8,4" Margin="0,0,8,0" Click="CopyPlexLink_Click"/>
            <Button Content="Copy TMDb API settings link" Padding="8,4" Margin="0,0,8,0" Click="CopyTmdbLink_Click"/>
            <Button Content="Close" Padding="16,4" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
